  "hasPart": [
    {
      "@type": "Dataset",
      "name": "Phase 1 — Initial Reference Establishment",
      "temporalCoverage": "2026-03-27/2026-04-08",
      "description": "Repeated same-region observation patterns and baseline continuity references were established."
    },
    {
      "@type": "Dataset",
      "name": "Phase 2 — Transition & Fluctuation Observation",
      "temporalCoverage": "2026-04-08/2026-04-22",
      "description": "Structural fluctuation density and repeated transitional observation sessions increased."
    },
    {
      "@type": "Dataset",
      "name": "Phase 3 — Gradual Reduction Observation",
      "temporalCoverage": "2026-04-22/2026-05-13",
      "description": "Chronological continuity remained stable while observation intervals expanded."
    },
    {
      "@type": "Dataset",
      "name": "Phase 4 — Intensive Monitoring Phase",
      "temporalCoverage": "2026-05-13/2026-05-23",
      "description": "High-frequency continuity monitoring and repeated same-day sessions were recorded."
    },
    {
      "@type": "Dataset",
      "name": "Phase 5 — Extended Longitudinal Observation",
      "temporalCoverage": "2026-05-24/2026-07-22",
      "description": "Longitudinal observation continued through repeated same-region photography to preserve chronological continuity and structural documentation over an extended observation period."
    }
  ],

  "additionalProperty": [
    {
      "@type": "PropertyValue",
      "name": "Structural Application",
      "value": "Application of the CS-NRRM™ structural observation approach to a longitudinal observation context separate from the original 12-year vitiligo archive."
    },
    {
      "@type": "PropertyValue",
      "name": "Chronology",
      "value": "Original temporal ordering of observations is preserved."
    },
    {
      "@type": "PropertyValue",
