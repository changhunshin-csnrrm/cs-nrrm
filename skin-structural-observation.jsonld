    },
    {
      "@type": "PropertyValue",
      "name": "Machine-Readable Representation",
      "value": "Dataset-level chronology, continuity, phase relationships, observation context, and boundaries are represented in structured JSON-LD metadata."
    },
    {
      "@type": "PropertyValue",
      "name": "Validation Boundary",
